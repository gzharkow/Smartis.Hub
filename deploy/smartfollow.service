# Шаблон systemd-юнита. Установка: см. DEPLOY.md, раздел 7.
# Если каталог проекта или пользователь называются иначе — поправить
# WorkingDirectory / ExecStart / User / Group ниже.

[Unit]
Description=Smartfollow (Next.js)
After=network.target postgresql.service

[Service]
Type=simple
User=smartfollow
Group=smartfollow
WorkingDirectory=/srv/smartfollow
EnvironmentFile=/srv/smartfollow/.env
ExecStart=/usr/bin/npm run start
Restart=on-failure
RestartSec=5

# Немного изоляции — процессу не нужен доступ к остальной системе,
# кроме собственного каталога и постоянного хранилища файлов.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/smartfollow

# Точный предпросмотр Спецификации конвертирует .docx в PDF через headless
# LibreOffice (см. src/lib/soffice.ts), а тот пишет во временный каталог и
# в свой профиль. С ProtectSystem=strict и без PrivateTmp каталог /tmp
# доступен процессу только на чтение — конвертация молча падала бы.
PrivateTmp=true
Environment=HOME=/var/lib/smartfollow

[Install]
WantedBy=multi-user.target
